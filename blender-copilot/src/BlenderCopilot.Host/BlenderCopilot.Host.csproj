<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlenderCopilot.Host</RootNamespace>
    <AssemblyName>BlenderCopilotHost</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1812;CA1031;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\acad-copilot\src\AcadCopilot.Core\AcadCopilot.Core.csproj" />
    <ProjectReference Include="..\..\..\acad-copilot\src\AcadCopilot.Plugin\AcadCopilot.Plugin.csproj" />
  </ItemGroup>

  <Target Name="UseWindowsSystemSpeech" AfterTargets="Build" Condition="Exists('$(OutDir)runtimes\win\lib\net10.0\System.Speech.dll')">
    <Copy SourceFiles="$(OutDir)runtimes\win\lib\net10.0\System.Speech.dll" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
