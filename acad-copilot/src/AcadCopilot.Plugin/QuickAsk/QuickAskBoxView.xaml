<UserControl x:Class="AcadCopilot.Plugin.QuickAsk.QuickAskBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:AcadCopilot.Plugin.Views"
             FontFamily="Segoe UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent"
             AutomationProperties.Name="Ask the AI">
    <!--
      The compact Quick Ask box next to the cursor: request text, point and selection chips, Pick, mic and Send.
      DataContext: QuickAskBoxViewModel. Enter sends, Esc closes (code-behind).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: the color palette (PanelThemes.Create), replaced by ApplyTheme. -->
                <ResourceDictionary />
            </ResourceDictionary.MergedDictionaries>

            <v:BoolToVisibilityConverter x:Key="Vis" />
            <Geometry x:Key="IconSparkle">M8,1 C8.4,4.6 9.4,6.4 15,8 C9.4,9.6 8.4,11.4 8,15 C7.6,11.4 6.6,9.6 1,8 C6.6,6.4 7.6,4.6 8,1 Z</Geometry>
            <Geometry x:Key="IconSend">M8,13 V3.2 M3.6,7.4 L8,3 L12.4,7.4</Geometry>
            <Geometry x:Key="IconCross">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</Geometry>
            <Geometry x:Key="IconMic">M8,1.6 C6.9,1.6 6,2.5 6,3.6 V7.9 C6,9 6.9,9.9 8,9.9 C9.1,9.9 10,9 10,7.9 V3.6 C10,2.5 9.1,1.6 8,1.6 Z M3.5,7.6 C3.5,10.2 5.5,12.2 8,12.2 C10.5,12.2 12.5,10.2 12.5,7.6 M8,12.2 V14.4 M5.6,14.4 H10.4</Geometry>
            <Geometry x:Key="IconPin">M8,14.4 C8,14.4 3.2,9.6 3.2,6.4 C3.2,3.7 5.4,1.6 8,1.6 C10.6,1.6 12.8,3.7 12.8,6.4 C12.8,9.6 8,14.4 8,14.4 Z M8,4.7 C8.9,4.7 9.7,5.5 9.7,6.4 C9.7,7.3 8.9,8.1 8,8.1 C7.1,8.1 6.3,7.3 6.3,6.4 C6.3,5.5 7.1,4.7 8,4.7 Z</Geometry>
            <Geometry x:Key="IconCrosshair">M8,1.5 V5.5 M8,10.5 V14.5 M1.5,8 H5.5 M10.5,8 H14.5 M8,5.5 C9.4,5.5 10.5,6.6 10.5,8 C10.5,9.4 9.4,10.5 8,10.5 C6.6,10.5 5.5,9.4 5.5,8 C5.5,6.6 6.6,5.5 8,5.5 Z</Geometry>
            <Geometry x:Key="IconSelect">M2.5,2.5 H5 M7,2.5 H9 M11,2.5 H13.5 V5 M13.5,7 V9 M2.5,4.5 V7 M2.5,9 V11 M2.5,13 V13.5 H5 M8,8 L14,10.2 L11.3,11.3 L10.2,14 Z</Geometry>

            <DropShadowEffect x:Key="Shadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />

            <ControlTemplate x:Key="RoundButtonTemplate" TargetType="ButtonBase">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                </Border>
            </ControlTemplate>

            <Style x:Key="BoxIconButton" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundButtonTemplate}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource BoxIconButton}">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MicButton" TargetType="Button" BasedOn="{StaticResource BoxIconButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Recording}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecordingForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Chips: "Cursor 12'-6", 30'-0"  x", "5 objects selected  x", "Pick point". -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="7,0,2,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftLine}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ChipClose" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundButtonTemplate}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="3,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundButtonTemplate}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="7,0,9,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="12"
            Width="440"
            CornerRadius="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource AccentSoftLine}"
            BorderThickness="1"
            Effect="{StaticResource Shadow}"
            Padding="10,8,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: badge, text, mic, send. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top" Margin="0,1,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F8CF0" Offset="0" />
                            <GradientStop Color="#5B5BE8" Offset="0.6" />
                            <GradientStop Color="#7A4FE0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <v:Icon Data="{StaticResource IconSparkle}" IsFilled="True" Foreground="White" Width="13" Height="13" />
                </Border>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Placeholder}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="13"
                               Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Text, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <TextBox x:Name="Input"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,3"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             SelectionBrush="{DynamicResource Accent}"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             MaxHeight="88"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"
                             FocusVisualStyle="{x:Null}"
                             AutomationProperties.Name="Request for the AI" />
                </Grid>
                <Grid Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasVoice, Converter={StaticResource Vis}}">
                    <v:PulseRing Width="28" Height="28" Foreground="{DynamicResource Recording}" Visibility="{Binding Voice.IsListening, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource MicButton}" Command="{Binding Voice.ToggleCommand}" ToolTip="{Binding Voice.MicToolTip}" AutomationProperties.Name="Speak">
                        <v:Icon Data="{StaticResource IconMic}" Width="15" Height="15" />
                    </Button>
                </Grid>
                <Button Grid.Column="3" Style="{StaticResource SendButton}" Margin="4,0,0,0" VerticalAlignment="Top"
                        Command="{Binding SendCommand}" ToolTip="Send (Enter)" AutomationProperties.Name="Send">
                    <v:Icon Data="{StaticResource IconSend}" Width="14" Height="14" StrokeThickness="1.9" />
                </Button>
            </Grid>

            <!-- Row 1: what goes with the request. -->
            <DockPanel Grid.Row="1" Margin="34,7,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource BoxIconButton}" Width="22" Height="22"
                        Command="{Binding CloseCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
                    <v:Icon Data="{StaticResource IconCross}" Width="10" Height="10" StrokeThickness="1.8" />
                </Button>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasPoint, Converter={StaticResource Vis}}" ToolTip="{Binding PointChipToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <v:Icon Data="{StaticResource IconPin}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" />
                            <TextBlock Text="{Binding PointChipText}" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <Button Style="{StaticResource ChipClose}" Command="{Binding RemovePointCommand}" ToolTip="Leave the point out">
                                <v:Icon Data="{StaticResource IconCross}" Width="8" Height="8" StrokeThickness="2" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" ToolTip="{Binding SelectionChipToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <v:Icon Data="{StaticResource IconSelect}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" StrokeThickness="1.3" />
                            <TextBlock Text="{Binding SelectionChipText}" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <Button Style="{StaticResource ChipClose}" Command="{Binding RemoveSelectionCommand}" ToolTip="Leave the selection out">
                                <v:Icon Data="{StaticResource IconCross}" Width="8" Height="8" StrokeThickness="2" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChipButton}" Command="{Binding PickCommand}"
                            ToolTip="Click the point in the drawing that the request is about (object snaps work)">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconCrosshair}" Width="12" Height="12" StrokeThickness="1.4" />
                            <TextBlock Text="Pick point" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding HintText}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="2,0,6,0" />
                </WrapPanel>
            </DockPanel>

            <!-- Row 2: mic state or a problem. -->
            <TextBlock Grid.Row="2"
                       Margin="34,6,6,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding StatusLine}"
                       Visibility="{Binding HasStatusLine, Converter={StaticResource Vis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource RecordingText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
