<UserControl x:Class="AcadCopilot.Plugin.Views.CopilotPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AcadCopilot.Plugin.ViewModels"
             xmlns:v="clr-namespace:AcadCopilot.Plugin.Views"
             x:Name="Root"
             MinWidth="260"
             MinHeight="300"
             FontFamily="Segoe UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="AI Copilot">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: the color palette, replaced by CopilotPane.ApplyTheme (PanelThemes.Create). -->
                <ResourceDictionary />
            </ResourceDictionary.MergedDictionaries>

            <v:BoolToVisibilityConverter x:Key="Vis" />
            <v:FractionToWidthConverter x:Key="FractionToWidth" />
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Icons: 16 x 16 design box, drawn by v:Icon. -->
            <Geometry x:Key="IconCheck">M3.5,8.5 L6.7,11.6 L12.8,4.6</Geometry>
            <Geometry x:Key="IconCross">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</Geometry>
            <Geometry x:Key="IconNewChat">M8.5,2.5 H3.5 C2.9,2.5 2.5,2.9 2.5,3.5 V12.5 C2.5,13.1 2.9,13.5 3.5,13.5 H12.5 C13.1,13.5 13.5,13.1 13.5,12.5 V7.5 M12.2,1.8 L14.2,3.8 L8.4,9.6 L5.9,10.1 L6.4,7.6 Z</Geometry>
            <Geometry x:Key="IconSliders">M2.5,4.5 H13.5 M2.5,11.5 H13.5 M5.5,2.5 V6.5 M10.5,9.5 V13.5</Geometry>
            <Geometry x:Key="IconClip">M11,5 L6,10 C5.4,10.6 5.4,11.4 6,12 C6.6,12.6 7.4,12.6 8,12 L13,7 C14.2,5.8 14.2,4 13,2.8 C11.8,1.6 10,1.6 8.8,2.8 L3.6,8 C1.9,9.7 1.9,12.3 3.6,14 C5.3,15.7 7.9,15.7 9.6,14</Geometry>
            <Geometry x:Key="IconSend">M8,13 V3.2 M3.6,7.4 L8,3 L12.4,7.4</Geometry>
            <Geometry x:Key="IconStop">M4.5,4.5 H11.5 V11.5 H4.5 Z</Geometry>
            <Geometry x:Key="IconChevronDown">M4.5,6.2 L8,9.8 L11.5,6.2</Geometry>
            <Geometry x:Key="IconChevronRight">M6.2,4.5 L9.8,8 L6.2,11.5</Geometry>
            <Geometry x:Key="IconRefresh">M13,8 C13,10.8 10.8,13 8,13 C5.2,13 3,10.8 3,8 C3,5.2 5.2,3 8,3 C9.7,3 11.2,3.8 12.1,5.1 M12.5,2 V5.3 H9.2</Geometry>
            <Geometry x:Key="IconWarning">M8,2.2 L14.3,13.3 H1.7 Z M8,6.5 V9.4 M8,11.4 V11.5</Geometry>
            <Geometry x:Key="IconFile">M4,1.8 H9.4 L12.5,4.9 V14.2 H4 Z M9.2,2 V5.1 H12.3</Geometry>
            <Geometry x:Key="IconImage">M2.2,3.2 H13.8 V12.8 H2.2 Z M2.4,11 L6,7.4 L8.8,10.2 L10.6,8.4 L13.6,11.4 M10.4,5.6 V5.7</Geometry>
            <Geometry x:Key="IconDraft">M2.5,13.5 H13.5 M3,11 L11.2,2.8 C11.7,2.3 12.5,2.3 13,2.8 C13.5,3.3 13.5,4.1 13,4.6 L4.8,12.8 L2.6,13.4 Z M10,4 L11.8,5.8</Geometry>
            <Geometry x:Key="IconSparkle">M8,1 C8.4,4.6 9.4,6.4 15,8 C9.4,9.6 8.4,11.4 8,15 C7.6,11.4 6.6,9.6 1,8 C6.6,6.4 7.6,4.6 8,1 Z</Geometry>
            <Geometry x:Key="IconQuestion">M8,1.8 C11.4,1.8 14.2,4.6 14.2,8 C14.2,11.4 11.4,14.2 8,14.2 C4.6,14.2 1.8,11.4 1.8,8 C1.8,4.6 4.6,1.8 8,1.8 Z M6.2,6.3 C6.2,5.3 7,4.6 8,4.6 C9,4.6 9.8,5.3 9.8,6.2 C9.8,7.6 8,7.6 8,9.1 M8,11.3 V11.4</Geometry>
            <Geometry x:Key="IconShield">M8,1.6 L13.4,3.6 V7.6 C13.4,10.9 11.1,13.3 8,14.4 C4.9,13.3 2.6,10.9 2.6,7.6 V3.6 Z M8,5.2 V8.6 M8,10.6 V10.7</Geometry>
            <Geometry x:Key="IconTasks">M6.5,4 H13.5 M6.5,8 H13.5 M6.5,12 H13.5 M2.6,3.4 L3.4,4.4 L4.6,2.8 M2.6,7.4 L3.4,8.4 L4.6,6.8 M3.2,12 H3.3</Geometry>
            <Geometry x:Key="IconSkip">M4,8 H12</Geometry>
            <Geometry x:Key="IconSignIn">M9.5,2.5 H12.8 C13.2,2.5 13.5,2.8 13.5,3.2 V12.8 C13.5,13.2 13.2,13.5 12.8,13.5 H9.5 M2.5,8 H9.6 M6.8,5.2 L9.6,8 L6.8,10.8</Geometry>
            <Geometry x:Key="IconEye">M1.5,8 C3.2,4.9 5.4,3.4 8,3.4 C10.6,3.4 12.8,4.9 14.5,8 C12.8,11.1 10.6,12.6 8,12.6 C5.4,12.6 3.2,11.1 1.5,8 Z M8,6 C9.1,6 10,6.9 10,8 C10,9.1 9.1,10 8,10 C6.9,10 6,9.1 6,8 C6,6.9 6.9,6 8,6 Z</Geometry>
            <Geometry x:Key="IconBolt">M9.2,1.6 L3.6,9.1 H7.6 L6.8,14.4 L12.4,6.9 H8.4 Z</Geometry>
            <Geometry x:Key="IconPrompt">M5,4.5 L8.5,8 L5,11.5</Geometry>
            <Geometry x:Key="IconPlus">M8,3 V13 M3,8 H13</Geometry>
            <Geometry x:Key="IconMic">M8,1.6 C6.9,1.6 6,2.5 6,3.6 V7.9 C6,9 6.9,9.9 8,9.9 C9.1,9.9 10,9 10,7.9 V3.6 C10,2.5 9.1,1.6 8,1.6 Z M3.5,7.6 C3.5,10.2 5.5,12.2 8,12.2 C10.5,12.2 12.5,10.2 12.5,7.6 M8,12.2 V14.4 M5.6,14.4 H10.4</Geometry>
            <Geometry x:Key="IconMicOff">M8,1.6 C6.9,1.6 6,2.5 6,3.6 V7.9 C6,9 6.9,9.9 8,9.9 C9.1,9.9 10,9 10,7.9 V3.6 C10,2.5 9.1,1.6 8,1.6 Z M3.5,7.6 C3.5,10.2 5.5,12.2 8,12.2 C10.5,12.2 12.5,10.2 12.5,7.6 M8,12.2 V14.4 M5.6,14.4 H10.4 M2.2,2.2 L13.8,13.8</Geometry>
            <Geometry x:Key="IconClock">M8,2 C11.3,2 14,4.7 14,8 C14,11.3 11.3,14 8,14 C4.7,14 2,11.3 2,8 C2,4.7 4.7,2 8,2 Z M8,4.8 V8.2 L10.4,9.6</Geometry>
            <Geometry x:Key="IconPause">M5.5,3.5 V12.5 M10.5,3.5 V12.5</Geometry>
            <Geometry x:Key="IconPlay">M5,3 L12.5,8 L5,13 Z</Geometry>
            <Geometry x:Key="IconStopFilled">M4,4 H12 V12 H4 Z</Geometry>
            <Geometry x:Key="IconTrash">M2.8,4.2 H13.2 M6.2,4.2 V2.6 H9.8 V4.2 M4.2,4.2 L5,13.4 H11 L11.8,4.2 M6.8,6.6 V11 M9.2,6.6 V11</Geometry>
            <Geometry x:Key="IconPin">M8,14.4 C8,14.4 3.2,9.6 3.2,6.4 C3.2,3.7 5.4,1.6 8,1.6 C10.6,1.6 12.8,3.7 12.8,6.4 C12.8,9.6 8,14.4 8,14.4 Z M8,4.7 C8.9,4.7 9.7,5.5 9.7,6.4 C9.7,7.3 8.9,8.1 8,8.1 C7.1,8.1 6.3,7.3 6.3,6.4 C6.3,5.5 7.1,4.7 8,4.7 Z</Geometry>
            <Geometry x:Key="IconQueueAdd">M2.2,3.8 H10.6 M2.2,7.6 H10.6 M2.2,11.4 H7 M12.4,8.8 V14 M9.8,11.4 H15</Geometry>
            <Geometry x:Key="IconQueue">M5.4,4 H13.6 M5.4,8 H13.6 M5.4,12 H13.6 M2.4,4 H2.6 M2.4,8 H2.6 M2.4,12 H2.6</Geometry>
            <Geometry x:Key="IconGrip">M5.2,4.6 H10.8 M5.2,8 H10.8 M5.2,11.4 H10.8</Geometry>
            <Geometry x:Key="IconArrowUp">M8,12.6 V3.6 M4.6,7 L8,3.6 L11.4,7</Geometry>
            <Geometry x:Key="IconArrowDown">M8,3.4 V12.4 M4.6,9 L8,12.4 L11.4,9</Geometry>
            <Geometry x:Key="IconEdit">M10.7,2.7 L13.3,5.3 L5.6,13 L2.6,13.4 L3,10.4 Z M9.3,4.1 L11.9,6.7</Geometry>
            <Geometry x:Key="IconCursor">M3.4,2.6 L12.4,7.1 L8.4,8.5 L6.6,12.6 Z M8.4,8.5 L11.6,13.2</Geometry>
            <Geometry x:Key="IconGlobe">M8,1.8 C11.4,1.8 14.2,4.6 14.2,8 C14.2,11.4 11.4,14.2 8,14.2 C4.6,14.2 1.8,11.4 1.8,8 C1.8,4.6 4.6,1.8 8,1.8 Z M1.8,8 H14.2 M2.7,4.9 H13.3 M2.7,11.1 H13.3 M8,1.8 C6.3,3.6 5.5,5.7 5.5,8 C5.5,10.3 6.3,12.4 8,14.2 M8,1.8 C9.7,3.6 10.5,5.7 10.5,8 C10.5,10.3 9.7,12.4 8,14.2</Geometry>
            <Geometry x:Key="IconLearn">M8,2.6 L14.6,5.8 L8,9 L1.4,5.8 Z M4.4,7.3 V10.6 C5.3,11.8 6.6,12.4 8,12.4 C9.4,12.4 10.7,11.8 11.6,10.6 V7.3 M14.6,5.8 V9.6</Geometry>
            <!-- Focus mode: a frame of four corners (expand / more room for the drawing). -->
            <Geometry x:Key="IconFocus">M2.5,6 V2.5 H6 M10,2.5 H13.5 V6 M13.5,10 V13.5 H10 M6,13.5 H2.5 V10 M6.2,6.2 H9.8 V9.8 H6.2 Z</Geometry>

            <!-- Focus ring for keyboard navigation. -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buttons -->
            <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="ButtonBase">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="False" />
                </Border>
            </ControlTemplate>

            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PressedBackground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Padding" Value="12,4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PressedBackground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MutedGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Small text link inside cards ("Show 3 more"). -->
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                <Setter Property="Padding" Value="3,1" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Full-width row that toggles details (CAD activity rows, plan header). -->
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Arrow" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PromptCard" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftLine}" />
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OptionCard" TargetType="Button" BasedOn="{StaticResource PromptCard}">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Margin" Value="0,0,0,5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ProviderTab" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SegmentSelected}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <!-- The provider cannot change during a turn, but the chosen one stays readable. -->
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- One chat tab (AutoCAD-like document tab): title, drawing chip, status; the selected one is raised. -->
            <Style x:Key="ChatTab" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </Border>
                                <Border x:Name="Marker" Height="2" Margin="6,0,6,1" VerticalAlignment="Bottom" CornerRadius="1"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Padding" Value="7,4,3,5" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="MaxWidth" Value="178" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Small close button inside a chat tab: shown on the selected tab and on hover. -->
            <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- One segment of a two-way switch (Watch / Fast). -->
            <Style x:Key="SegmentRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="7,2,8,2">
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentSelected}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Read-only, selectable, wrapping text. -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="v:WheelForwarding.IsEnabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="-2,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InputBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Background" Value="{DynamicResource InputBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="{TemplateBinding Padding}"
                                               Padding="2,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComposerBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,9,10,4" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="AcceptsTab" Value="False" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="MaxHeight" Value="170" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="SpellCheck.IsEnabled" Value="False" />
            </Style>

            <!-- Slim scroll bars. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource ScrollThumb}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="8" />
                        <Setter Property="MinHeight" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" Margin="2,1">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="3" Background="{DynamicResource ScrollThumb}" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="MaxWidth" Value="420" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThemedRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource StrongLineBrush}" StrokeThickness="1.5" Fill="{DynamicResource InputBackground}" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Check box (settings). -->
            <Style x:Key="ThemedCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0"
                                        BorderBrush="{DynamicResource StrongLineBrush}" Background="{DynamicResource InputBackground}">
                                    <v:Icon x:Name="Tick" Data="{StaticResource IconCheck}" Width="11" Height="11" StrokeThickness="2.2"
                                            Foreground="{DynamicResource AccentForeground}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mic button of the composer: an icon button, red with a pulse while listening. -->
            <Style x:Key="MicButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <v:PulseRing x:Name="Pulse" Foreground="{DynamicResource Recording}" Visibility="Collapsed" />
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                                    <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Recording}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecordingForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Model drop-down. -->
            <Style x:Key="ComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ModelChoiceTemplate">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>

            <Style x:Key="ThemedCombo" TargetType="ComboBox">
                <Setter Property="ItemTemplate" Value="{StaticResource ModelChoiceTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Background" Value="{DynamicResource InputBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="{DynamicResource InputBackground}"
                                                    BorderBrush="{DynamicResource StrongLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <v:Icon Data="{StaticResource IconChevronDown}" Width="12" Height="12"
                                                        HorizontalAlignment="Right" Margin="0,0,7,0"
                                                        Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="8,0,24,0"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="None"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="2"
                                            Margin="0,2,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- The task list of the checklist; the pinned copy overrides this key with a height limit. -->
            <Style x:Key="PlanTaskScroller" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- Provider status dot. -->
            <DataTemplate x:Key="StatusDot" DataType="{x:Type vm:ProviderViewModel}">
                <Grid Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource Success}" Visibility="{Binding IsReady, Converter={StaticResource Vis}}" />
                    <Ellipse Fill="{DynamicResource Warning}" Visibility="{Binding IsSignedOut, Converter={StaticResource Vis}}" />
                    <Ellipse Fill="{DynamicResource TextMuted}" Visibility="{Binding IsNotInstalled, Converter={StaticResource Vis}}" />
                    <Ellipse Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2" Visibility="{Binding IsUnknown, Converter={StaticResource Vis}}" />
                </Grid>
            </DataTemplate>

            <!-- Task Progress checklist (live and in the conversation). -->
            <DataTemplate DataType="{x:Type vm:PlanViewModel}">
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Button Style="{StaticResource RowButton}" Command="{Binding ToggleCommand}" Padding="10,7"
                                AutomationProperties.Name="{Binding Header}" ToolTip="Show or hide the tasks">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <v:Icon Data="{StaticResource IconTasks}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <v:Icon Grid.Column="2" Width="12" Height="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <v:Icon.Style>
                                        <Style TargetType="v:Icon">
                                            <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </v:Icon.Style>
                                </v:Icon>
                            </Grid>
                        </Button>
                        <Grid x:Name="Track" Height="3" Margin="10,0,10,8">
                            <Border Background="{DynamicResource SurfaceAltBackground}" CornerRadius="1.5" />
                            <Border Background="{DynamicResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="Fraction" />
                                        <Binding Path="ActualWidth" ElementName="Track" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <ScrollViewer Style="{DynamicResource PlanTaskScroller}" Margin="10,0,4,8"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,0,6,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlanTaskViewModel}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0" HorizontalAlignment="Left">
                                                <Ellipse Stroke="{DynamicResource StrongLineBrush}" StrokeThickness="1.3" Margin="1"
                                                         Visibility="{Binding IsPending, Converter={StaticResource Vis}}" />
                                                <v:Spinner Width="13" Height="13" Foreground="{DynamicResource AccentText}"
                                                           Visibility="{Binding IsInProgress, Converter={StaticResource Vis}}" />
                                                <Grid Visibility="{Binding IsCompleted, Converter={StaticResource Vis}}">
                                                    <Ellipse Fill="{DynamicResource Success}" />
                                                    <v:Icon Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2" Foreground="White" />
                                                </Grid>
                                                <Grid Visibility="{Binding IsFailed, Converter={StaticResource Vis}}">
                                                    <Ellipse Fill="{DynamicResource Danger}" />
                                                    <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" StrokeThickness="2.2" Foreground="White" />
                                                </Grid>
                                                <v:Icon Data="{StaticResource IconSkip}" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"
                                                        Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Conversation item templates. -->
            <DataTemplate DataType="{x:Type vm:UserMessageItem}">
                <Grid Margin="40,8,0,6">
                    <Border HorizontalAlignment="Right" Background="{DynamicResource UserBubble}" CornerRadius="10,10,3,10" Padding="10,7">
                        <StackPanel>
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                     Foreground="{DynamicResource UserBubbleText}"
                                     Visibility="{Binding HasText, Converter={StaticResource Vis}}"
                                     AutomationProperties.Name="Your message" />
                            <ItemsControl ItemsSource="{Binding AttachmentNames}" Focusable="False"
                                          Visibility="{Binding HasAttachments, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <v:Icon Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="{DynamicResource UserBubbleText}" Opacity="0.75" />
                                            <TextBlock Text="{Binding}" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource UserBubbleText}" Opacity="0.85"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The message carried the user's AutoCAD selection. -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasSelectionNote, Converter={StaticResource Vis}}"
                                        ToolTip="The handles and a short description of these objects went with the message">
                                <v:Icon Data="{StaticResource IconCursor}" Width="12" Height="12" Foreground="{DynamicResource UserBubbleText}" Opacity="0.75" />
                                <TextBlock Text="{Binding SelectionNote}" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource UserBubbleText}" Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,6,0" Padding="5,0,6,1" CornerRadius="6"
                            Background="{DynamicResource SurfaceAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Visibility="{Binding FromQueue, Converter={StaticResource Vis}}" ToolTip="Started from this chat's queue">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconQueue}" Width="10" Height="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="from queue" FontSize="9.5" Margin="3,0,0,0" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AssistantMessageItem}">
                <StackPanel Margin="0,6,0,6">
                    <v:MarkdownView Markdown="{Binding Text}" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                    SelectionBrush="{DynamicResource Accent}"
                                    AutomationProperties.Name="Assistant message" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource Vis}}">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextMuted}" Margin="0,0,3,0" />
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextMuted}" Margin="0,0,3,0" Opacity="0.7" />
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextMuted}" Opacity="0.4" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- One AutoCAD command of a run_commands call, as typed in the command line. -->
            <DataTemplate DataType="{x:Type vm:CommandStepItem}">
                <StackPanel Background="Transparent" ToolTip="{Binding ToolTip}" Margin="0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <v:Icon Data="{StaticResource IconPrompt}" Width="10" Height="10" StrokeThickness="1.8" Foreground="{DynamicResource TextMuted}"
                                    Visibility="{Binding IsUnknown, Converter={StaticResource Vis}}" />
                            <v:Icon Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2" Foreground="{DynamicResource Success}"
                                    Visibility="{Binding IsDone, Converter={StaticResource Vis}}" />
                            <v:Icon Data="{StaticResource IconWarning}" Width="10" Height="10" StrokeThickness="1.6" Foreground="{DynamicResource Warning}"
                                    Visibility="{Binding IsWarning, Converter={StaticResource Vis}}" />
                            <v:Icon Data="{StaticResource IconCross}" Width="10" Height="10" StrokeThickness="2.2" Foreground="{DynamicResource Danger}"
                                    Visibility="{Binding IsFailed, Converter={StaticResource Vis}}" />
                            <v:Icon Data="{StaticResource IconSkip}" Width="10" Height="10" StrokeThickness="1.8" Foreground="{DynamicResource TextMuted}"
                                    Visibility="{Binding IsNotRun, Converter={StaticResource Vis}}" />
                        </Grid>
                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   VerticalAlignment="Center"><Run Text="{Binding Command, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><Run Text="{Binding InputsDisplay, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding AutoFixedText}" Margin="14,1,0,1" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                               Visibility="{Binding HasAutoFixed, Converter={StaticResource Vis}}" AutomationProperties.Name="Auto-fixed" />
                    <TextBlock Text="{Binding Problem}" Margin="14,1,0,1" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding HasProblem, Converter={StaticResource Vis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ActivityGroupItem}">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,4,0,6">
                    <StackPanel>
                        <Button Style="{StaticResource RowButton}" Command="{Binding ToggleCommand}" Padding="10,7"
                                AutomationProperties.Name="CAD activity" ToolTip="Show or hide what the AI did in AutoCAD">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <v:Icon Data="{StaticResource IconDraft}" Foreground="{DynamicResource AccentText}" />
                                <TextBlock Grid.Column="1" Text="{Binding GroupTitle}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <v:Spinner Grid.Column="2" Width="12" Height="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentText}"
                                           Visibility="{Binding HasRunning, Converter={StaticResource Vis}}" />
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <v:Icon Grid.Column="4" Width="12" Height="12" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}">
                                    <v:Icon.Style>
                                        <Style TargetType="v:Icon">
                                            <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </v:Icon.Style>
                                </v:Icon>
                            </Grid>
                        </Button>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,3,0,4"
                                Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolActivityItem}">
                                        <StackPanel Margin="0,0,0,2">
                                            <Button Style="{StaticResource RowButton}" Command="{Binding ToggleCommand}" Padding="10,4"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                                        <v:Spinner Width="13" Height="13" Foreground="{DynamicResource AccentText}"
                                                                   Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                                                        <Grid Visibility="{Binding IsSucceeded, Converter={StaticResource Vis}}">
                                                            <Ellipse Fill="{DynamicResource Success}" />
                                                            <v:Icon Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2" Foreground="White" />
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsFailed, Converter={StaticResource Vis}}">
                                                            <Ellipse Fill="{DynamicResource Danger}" />
                                                            <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" StrokeThickness="2.2" Foreground="White" />
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsCancelled, Converter={StaticResource Vis}}">
                                                            <Ellipse Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" Margin="1" />
                                                            <v:Icon Data="{StaticResource IconSkip}" Width="9" Height="9" Foreground="{DynamicResource TextMuted}" />
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SubtitleText, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" FontSize="11" /></TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                               Margin="6,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </Button>
                                            <!-- The commands typed into AutoCAD's command line. -->
                                            <Border Background="{DynamicResource CodeBackground}" CornerRadius="4" Padding="7,3,7,3" Margin="32,0,10,3"
                                                    Visibility="{Binding HasSteps, Converter={StaticResource Vis}}">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding VisibleSteps}" Focusable="False" />
                                                    <Button Style="{StaticResource LinkButton}" Content="{Binding MoreStepsText}" Command="{Binding ToggleStepsCommand}"
                                                            Margin="10,0,0,1" Visibility="{Binding HasHiddenSteps, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding OutcomeText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="32,0,10,3"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasOutcome, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding ResultSummary}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="32,0,10,3"
                                                       TextWrapping="Wrap" Visibility="{Binding ShowResultLine, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding CheckpointText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="32,0,10,3"
                                                       TextWrapping="Wrap" Visibility="{Binding HasCheckpoint, Converter={StaticResource Vis}}" />
                                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Margin="32,1,10,4" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasPicture, Converter={StaticResource Vis}}">
                                                <Image Source="{Binding Picture}" MaxHeight="150" MaxWidth="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       AutomationProperties.Name="Picture of the drawing" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="32,0,10,3" Visibility="{Binding HasExportFile, Converter={StaticResource Vis}}">
                                                <Button Style="{StaticResource LinkButton}" Content="Open exports folder" ToolTip="{Binding ExportFile}"
                                                        Command="{Binding DataContext.OpenExportFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type v:CopilotPane}}}" CommandParameter="{Binding ExportFile}"
                                                        AutomationProperties.Name="Open exports folder" />
                                                <TextBlock Text="{Binding ExportFileName}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="32,0,10,3" Focusable="False"
                                                          Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <v:Icon Data="{StaticResource IconWarning}" Width="11" Height="11" StrokeThickness="1.6" Foreground="{DynamicResource Warning}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Error, Mode=OneWay}"
                                                     Foreground="{DynamicResource Danger}" FontSize="11" Margin="32,0,10,4"
                                                     Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                                            <Border Background="{DynamicResource CodeBackground}" CornerRadius="4" Padding="8,5" Margin="32,0,10,5"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding DetailsText, Mode=OneWay}"
                                                         FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuestionCardItem}">
                <Border Margin="0,4,0,6" Padding="12,10">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftLine}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                    <Setter Property="Padding" Value="10,7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Open: question(s) with option cards. -->
                        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <v:Icon Data="{StaticResource IconQuestion}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <Button Grid.Column="2" Style="{StaticResource MutedGhostButton}" Content="Skip" Command="{Binding SkipCommand}"
                                        ToolTip="Skip these questions (the AI is told you skipped them)" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuestionViewModel}">
                                        <StackPanel Margin="0,2,0,8">
                                            <Border HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="0,0,0,5"
                                                    Visibility="{Binding HasHeader, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                            </Border>
                                            <v:MarkdownView Markdown="{Binding Question}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,7"
                                                            SelectionBrush="{DynamicResource Accent}" AutomationProperties.Name="Question" />
                                            <TextBlock Text="Select all that apply" Style="{StaticResource Caption}" Margin="0,-4,0,6"
                                                       Visibility="{Binding ShowMultiSelectHint, Converter={StaticResource Vis}}" />
                                            <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                                                        <Button Style="{StaticResource OptionCard}" Command="{Binding SelectCommand}"
                                                                AutomationProperties.Name="{Binding Label}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="Indicator" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" Margin="0,1,0,0"
                                                                        VerticalAlignment="Top"
                                                                        BorderBrush="{DynamicResource StrongLineBrush}" Background="{DynamicResource InputBackground}">
                                                                    <v:Icon x:Name="Tick" Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2"
                                                                            Foreground="White" Visibility="Collapsed" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding RecommendedTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" /></TextBlock>
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                                               Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                                                <Setter TargetName="Indicator" Property="CornerRadius" Value="3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}" />
                                                                <Setter TargetName="Indicator" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Command="{Binding OtherCommand}" AutomationProperties.Name="Other answer"
                                                    Visibility="{Binding AllowCustom, Converter={StaticResource Vis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource OptionCard}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOtherSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <v:Icon Data="{StaticResource IconNewChat}" Width="13" Height="13" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="Other..." Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBox Style="{StaticResource InputBox}" Tag="Type your answer, then press Enter"
                                                     Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Your answer"
                                                     Visibility="{Binding IsOtherSelected, Converter={StaticResource Vis}}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding Card.SubmitCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PrimaryButton}" Content="Submit answers" HorizontalAlignment="Right"
                                    Command="{Binding SubmitCommand}" Visibility="{Binding ShowSubmit, Converter={StaticResource Vis}}" />
                        </StackPanel>

                        <!-- Answered: collapsed to a check mark and the answers. -->
                        <Grid Visibility="{Binding IsAnswered, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Grid Visibility="{Binding IsSkipped, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <Ellipse Fill="{DynamicResource Success}" />
                                    <v:Icon Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2" Foreground="White" />
                                </Grid>
                                <Grid Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}">
                                    <Ellipse Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" Margin="1" />
                                    <v:Icon Data="{StaticResource IconSkip}" Width="9" Height="9" Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Questions skipped" Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                                <ItemsControl ItemsSource="{Binding Questions}" Focusable="False"
                                              Visibility="{Binding IsSkipped, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QuestionViewModel}">
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"><Run Text="{Binding AnswerLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" /><Run Text=": " Foreground="{DynamicResource TextSecondary}" /><Run Text="{Binding AnswerText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ApprovalCardItem}">
                <Border Margin="0,4,0,6" Padding="12,10">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningLine}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                    <Setter Property="Padding" Value="10,7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel Visibility="{Binding IsPending, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <v:Icon Data="{StaticResource IconShield}" Foreground="{DynamicResource Warning}" />
                                <TextBlock Text="Approval needed" FontWeight="SemiBold" Margin="7,0,0,0" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ToolTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Summary, Mode=OneWay}" Margin="0,3,0,0" />
                            <TextBlock Text="Nothing runs until you choose." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <Button Style="{StaticResource MutedGhostButton}" Command="{Binding ToggleDetailsCommand}" HorizontalAlignment="Left"
                                    Margin="-6,4,0,0" Visibility="{Binding HasArguments, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Width="11" Height="11">
                                        <v:Icon.Style>
                                            <Style TargetType="v:Icon">
                                                <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </v:Icon.Style>
                                    </v:Icon>
                                    <TextBlock Text="Details" Margin="4,0,0,0" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource CodeBackground}" CornerRadius="4" Padding="8,5" Margin="0,2,0,0"
                                    Visibility="{Binding ShowDetails, Converter={StaticResource Vis}}">
                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding ArgumentsText, Mode=OneWay}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Approve" Command="{Binding ApproveCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Reject" Command="{Binding RejectCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Always allow" Command="{Binding AlwaysCommand}"
                                        ToolTip="Run this without asking until New chat"
                                        Visibility="{Binding ShowAlways, Converter={StaticResource Vis}}" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Visibility="{Binding IsResolved, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Grid Visibility="{Binding IsRejected, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <Ellipse Fill="{DynamicResource Success}" />
                                    <v:Icon Data="{StaticResource IconCheck}" Width="10" Height="10" StrokeThickness="2.2" Foreground="White" />
                                </Grid>
                                <Grid Visibility="{Binding IsRejected, Converter={StaticResource Vis}}">
                                    <Ellipse Fill="{DynamicResource Danger}" />
                                    <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" StrokeThickness="2.2" Foreground="White" />
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap"><Run Text="{Binding ToolTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><Run Text=" · " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding DecisionText, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ErrorItem}">
                <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="6"
                        Padding="12,10" Margin="0,4,0,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconWarning}" Foreground="{DynamicResource Danger}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,0,0" Foreground="{DynamicResource Danger}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Message, Mode=OneWay}" Margin="0,5,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"
                                Visibility="{Binding ShowSignIn, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <v:Icon Data="{StaticResource IconSignIn}" Width="13" Height="13" />
                                <TextBlock Text="{Binding SignInText}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TurnFooterItem}">
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                        <v:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"
                                Visibility="{Binding IsCompleted, Converter={StaticResource Vis}}" />
                        <v:Icon Data="{StaticResource IconStop}" Width="11" Height="11" Foreground="{DynamicResource TextMuted}"
                                Visibility="{Binding IsStopped, Converter={StaticResource Vis}}" />
                        <v:Icon Data="{StaticResource IconCross}" Width="12" Height="12" Foreground="{DynamicResource Danger}"
                                Visibility="{Binding IsFailed, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="5,0,8,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlanCardItem}">
                <ContentControl Content="{Binding Plan}" Margin="0,4,0,6" Focusable="False" />
            </DataTemplate>

            <!-- AI switching: one line where another AI took over. -->
            <DataTemplate DataType="{x:Type vm:SwitchNoticeItem}">
                <Border Margin="0,4,0,6" Padding="9,6" CornerRadius="6" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningLine}"
                        BorderThickness="1" ToolTip="{Binding Detail}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <v:Icon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="8,0,0,0" FontSize="11.5" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Second-opinion review: verdict, findings, Fix these. -->
            <DataTemplate DataType="{x:Type vm:ReviewCardItem}">
                <Border Style="{StaticResource Card}" Margin="0,4,0,6" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <v:Icon Data="{StaticResource IconShield}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClean}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </Grid>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Summary, Mode=OneWay}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}" />
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,6,0,0" Focusable="False" Visibility="{Binding HasFindings, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReviewFindingRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Badge" CornerRadius="3" Padding="0,1" VerticalAlignment="Top" Margin="0,1,6,0" Background="{DynamicResource SurfaceAltBackground}">
                                            <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="11.5" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMajor}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoft}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding HasFindings, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding FixCommand}" Padding="11,4" AutomationProperties.Name="Fix these"
                                    ToolTip="Ask the drafting AI to correct these findings (queued while this chat is still working)">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IconDraft}" Width="12" Height="12" />
                                    <TextBlock Text="{Binding FixButtonText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- An unfinished drafting job from the journal: Resume or Dismiss. -->
            <DataTemplate DataType="{x:Type vm:ResumeCardItem}">
                <Border Margin="0,4,0,6" Padding="12,10" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <v:Icon Data="{StaticResource IconRefresh}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding RemainingTasks}" Margin="0,4,0,0" Focusable="False"
                                      Visibility="{Binding HasRemainingTasks, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <Ellipse Width="9" Height="9" Stroke="{DynamicResource StrongLineBrush}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="11.5" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Summary, Mode=OneWay}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResumeCommand}" Padding="11,4" AutomationProperties.Name="Resume job"
                                    ToolTip="The AI checks the drawing, then continues with what is left">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IconPlay}" IsFilled="True" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Resume" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MutedGhostButton}" Content="Dismiss" Padding="9,4" Margin="6,0,0,0" Command="{Binding DismissCommand}"
                                    ToolTip="Forget this unfinished job" AutomationProperties.Name="Dismiss job" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasOutcome, Converter={StaticResource Vis}}">
                            <v:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding Outcome}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="5,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="{DynamicResource PanelBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: chat tabs, title, drawing, New chat, settings, provider switch, sign-in status and model. -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,9,8,9">
            <StackPanel>
                <!-- Chat tabs (DataContext: CopilotPanelViewModel, set in code). Each tab is its own conversation on the
                     drawing that was active when it was opened; tabs work in parallel and take turns in AutoCAD. -->
                <StackPanel x:Name="TabStrip" Margin="-12,-9,-8,9">
                    <Border Background="{DynamicResource SurfaceAltBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                            Padding="6,5,4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" KeyboardNavigation.TabNavigation="Continue"
                                          AutomationProperties.Name="Chat tabs">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                                        <Button Style="{StaticResource ChatTab}"
                                                Command="{Binding DataContext.SelectTabCommand, ElementName=TabStrip}" CommandParameter="{Binding}"
                                                ToolTip="{Binding TabToolTip}" AutomationProperties.Name="{Binding Title}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- What the chat is doing. -->
                                                <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <v:Icon x:Name="IdleGlyph" Data="{StaticResource IconSparkle}" IsFilled="True" Width="10" Height="10"
                                                            Foreground="{DynamicResource TextMuted}" />
                                                    <v:Spinner x:Name="WorkingGlyph" Width="11" Height="11" Foreground="{DynamicResource AccentText}" Visibility="Collapsed" />
                                                    <v:Icon x:Name="DrawingGlyph" Data="{StaticResource IconDraft}" Width="12" Height="12"
                                                            Foreground="{DynamicResource AccentText}" Visibility="Collapsed" />
                                                    <v:Icon x:Name="WaitingGlyph" Data="{StaticResource IconClock}" Width="12" Height="12"
                                                            Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                                                    <v:Icon x:Name="AnswerGlyph" Data="{StaticResource IconQuestion}" Width="12" Height="12"
                                                            Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Style="{StaticResource TabCloseButton}" Margin="3,-2,0,-2" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.CloseTabCommand, ElementName=TabStrip}" CommandParameter="{Binding}"
                                                        ToolTip="Close this chat" AutomationProperties.Name="Close chat">
                                                    <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" />
                                                </Button>

                                                <!-- The drawing this chat works on, and its place in AutoCAD's queue. -->
                                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <v:Icon Data="{StaticResource IconFile}" Width="10" Height="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DrawingChip" Grid.Column="1" Text="{Binding DrawingTitle}" FontSize="10" Margin="3,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TabStatus" Grid.Column="2" Text="{Binding TabStatusText}" FontSize="10" Margin="5,0,0,0"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                                                               Visibility="{Binding HasTabStatus, Converter={StaticResource Vis}}" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                                <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDrawingClosed}" Value="True">
                                                <Setter TargetName="DrawingChip" Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TabState}" Value="Working">
                                                <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="WorkingGlyph" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="TabStatus" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                <Setter TargetName="TabStatus" Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TabState}" Value="Drawing">
                                                <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DrawingGlyph" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TabState}" Value="Waiting">
                                                <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="WaitingGlyph" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="TabStatus" Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TabState}" Value="NeedsAnswer">
                                                <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="AnswerGlyph" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="TabStatus" Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="2,3,0,0" Width="26" Height="26"
                                    Command="{Binding NewTabCommand}" ToolTip="{Binding NewTabToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="New chat tab">
                                <v:Icon Data="{StaticResource IconPlus}" />
                            </Button>
                            <!-- "2 of 4 chats working" once more than one tab exists. -->
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RunningText}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="4,0,6,4" HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunningText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- Closing a chat that is still working asks first. -->
                    <Border Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningLine}" BorderThickness="0,0,0,1"
                            Padding="12,7,8,7" Visibility="{Binding HasPendingClose, Converter={StaticResource Vis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <v:Icon Data="{StaticResource IconWarning}" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PendingCloseText}" FontSize="11.5" TextWrapping="Wrap" Margin="8,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Stop and close" FontSize="11" Padding="9,3"
                                    Command="{Binding ConfirmCloseCommand}" />
                            <Button Grid.Column="3" Style="{StaticResource MutedGhostButton}" Content="Keep" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                                    Command="{Binding CancelCloseCommand}" />
                        </Grid>
                    </Border>

                    <!-- LEARN FROM ME: one recorder for every tab. Off: "Start learning"; on: red "Learning from you · 03:12 · 47
                         actions" with Pause / Resume, Stop & learn and Discard (asks first). Only the user's click starts it. -->
                    <Grid Visibility="{Binding HasLearning, Converter={StaticResource Vis}}">
                        <Grid DataContext="{Binding Learning}">
                            <!-- Off. -->
                            <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,5,8,5" Visibility="{Binding ShowIdle, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <v:Icon Data="{StaticResource IconLearn}" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding IdleBannerText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               Margin="7,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StartToolTip}" />
                                    <Button x:Name="StartLearningButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="9,3" FontSize="11"
                                            Command="{Binding StartCommand}" ToolTip="{Binding StartToolTip}" AutomationProperties.Name="Start learning">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Recording}" VerticalAlignment="Center" />
                                            <TextBlock Text="Start learning" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Recording or paused. -->
                            <Border BorderThickness="0,0,0,1" Padding="12,6,8,7" Visibility="{Binding ShowActive, Converter={StaticResource Vis}}"
                                    AutomationProperties.Name="{Binding StatusText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource RecordingSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningLine}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Pulsing red dot while recording, amber pause mark while paused. -->
                                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                                        <v:PulseRing Foreground="{DynamicResource Recording}" Growth="2.4"
                                                     Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                        <Ellipse Fill="{DynamicResource Recording}" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}" />
                                        <v:Icon Data="{StaticResource IconPause}" Width="11" Height="11" StrokeThickness="2.4" Foreground="{DynamicResource Warning}"
                                                Visibility="{Binding IsPaused, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <TextBlock x:Name="LearningHeadline" Grid.Column="1" Text="{Binding HeadlineText}" FontWeight="SemiBold" Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource RecordingText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <Run Text=" · " /><Run Text="{Binding ElapsedText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" · " /><Run Text="{Binding ActionsText, Mode=OneWay}" />
                                    </TextBlock>

                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding PauseCommand}" Visibility="{Binding IsRecording, Converter={StaticResource Vis}}"
                                                ToolTip="Stop capturing for a while; nothing recorded is lost" AutomationProperties.Name="Pause learning">
                                            <StackPanel Orientation="Horizontal">
                                                <v:Icon Data="{StaticResource IconPause}" Width="11" Height="11" StrokeThickness="2.2" VerticalAlignment="Center" />
                                                <TextBlock Text="Pause" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding ResumeCommand}" Visibility="{Binding IsPaused, Converter={StaticResource Vis}}"
                                                ToolTip="Capture your work again" AutomationProperties.Name="Resume learning">
                                            <StackPanel Orientation="Horizontal">
                                                <v:Icon Data="{StaticResource IconPlay}" IsFilled="True" Width="10" Height="10" VerticalAlignment="Center" />
                                                <TextBlock Text="Resume" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding StopAndLearnCommand}"
                                                ToolTip="Stop, save the recording on this PC and let the AI learn your way of drawing from it"
                                                AutomationProperties.Name="Stop and learn">
                                            <StackPanel Orientation="Horizontal">
                                                <v:Icon Data="{StaticResource IconStopFilled}" IsFilled="True" Width="9" Height="9" VerticalAlignment="Center" />
                                                <TextBlock Text="Stop &amp; learn" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MutedGhostButton}" Padding="7,3" FontSize="11"
                                                Command="{Binding DiscardCommand}" ToolTip="Throw this recording away (nothing is saved or learned)"
                                                AutomationProperties.Name="Discard recording">
                                            <StackPanel Orientation="Horizontal">
                                                <v:Icon Data="{StaticResource IconTrash}" Width="11" Height="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Discard" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- Discard asks first. -->
                            <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="0,0,0,1"
                                    Padding="12,7,8,7" Visibility="{Binding IsConfirmingDiscard, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <v:Icon Data="{StaticResource IconTrash}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DiscardQuestion}" FontSize="11.5" TextWrapping="Wrap" Margin="8,0,8,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Discard" FontSize="11" Padding="9,3"
                                            Foreground="{DynamicResource Danger}" Command="{Binding ConfirmDiscardCommand}" AutomationProperties.Name="Discard the recording" />
                                    <Button Grid.Column="3" Style="{StaticResource MutedGhostButton}" Content="Keep" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                                            Command="{Binding CancelDiscardCommand}" AutomationProperties.Name="Keep recording" />
                                </Grid>
                            </Border>

                            <!-- Stop & learn is saving. -->
                            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}" BorderThickness="0,0,0,1"
                                    Padding="12,7,8,7" Visibility="{Binding IsSaving, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <v:Spinner Width="12" Height="12" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                    <TextBlock Text="Saving your recording and learning your style..." FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Title row. Below 420 px (CopilotPane.ApplyCompactHeader) the logo, title, provider switch and status row
                     give way to CompactProviderBar: one slim line with the provider and model drop-downs. -->
                <Grid x:Name="HeaderTitleRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderLogo" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <v:Icon Data="{StaticResource IconSparkle}" IsFilled="True" Width="15" Height="15" Foreground="{DynamicResource AccentForeground}" />
                    </Border>
                    <StackPanel x:Name="HeaderTitle" Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="AI Copilot" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding DocumentText}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DocumentText}" />
                    </StackPanel>

                    <!-- Slim header: provider (with its sign-in dot), Sign in when needed, model. -->
                    <Grid x:Name="CompactProviderBar" Grid.ColumnSpan="2" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CompactProviderCombo" Style="{StaticResource ThemedCombo}" MinWidth="88" MaxWidth="150" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                  ToolTip="{Binding SelectedProvider.DetailText}" AutomationProperties.Name="AI provider">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusDot}" />
                                        <TextBlock Text="{Binding DisplayName}" Margin="6,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Sign in" FontSize="11" Padding="5,2" Margin="4,0,0,0"
                                Command="{Binding SignInCommand}" CommandParameter="{Binding SelectedProvider}"
                                ToolTip="Opens the official sign-in in a terminal window"
                                Visibility="{Binding SelectedProvider.CanSignIn, Converter={StaticResource Vis}}" />
                        <ComboBox Grid.Column="2" Style="{StaticResource ThemedCombo}" MinWidth="74" MaxWidth="118" Margin="4,0,0,0"
                                  ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}" ToolTip="Model" AutomationProperties.Name="Model"
                                  Visibility="{Binding HasModelChoice, Converter={StaticResource Vis}}" />
                    </Grid>

                    <!-- Focus mode: ribbon minimised, ViewCube and navigation bar hidden (inside AutoCAD only). -->
                    <Button x:Name="FocusButton" Grid.Column="2" Command="{Binding Layout.ToggleFocusCommand}" ToolTip="{Binding Layout.FocusToolTip}"
                            AutomationProperties.Name="Focus mode"
                            Visibility="{Binding Layout.CanFocus, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.IsFocusMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <v:Icon Data="{StaticResource IconFocus}" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding NewChatCommand}" Margin="2,0,0,0"
                            ToolTip="Start this tab over (new conversation)" AutomationProperties.Name="New chat">
                        <v:Icon Data="{StaticResource IconNewChat}" />
                    </Button>
                    <Button Grid.Column="4" Command="{Binding ToggleSettingsCommand}" Margin="2,0,0,0"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <v:Icon Data="{StaticResource IconSliders}" />
                    </Button>
                </Grid>

                <Border x:Name="ProviderSegment" Background="{DynamicResource SegmentTrack}" CornerRadius="6" Padding="2" Margin="0,9,4,0">
                    <ItemsControl ItemsSource="{Binding Providers}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                                <Button Style="{StaticResource ProviderTab}"
                                        Command="{Binding DataContext.SelectProviderCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusDot}" />
                                        <TextBlock Text="{Binding DisplayName}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid x:Name="ProviderStatusRow" Margin="0,8,4,0" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" DataContext="{Binding SelectedProvider}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusDot}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="6,0,4,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Sign in" FontSize="11" Padding="6,2"
                                Command="{Binding DataContext.SignInCommand, ElementName=Root}" CommandParameter="{Binding}"
                                ToolTip="Opens the official sign-in in a terminal window"
                                Visibility="{Binding CanSignIn, Converter={StaticResource Vis}}" />
                        <v:Spinner Grid.Column="3" Width="11" Height="11" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding IsChecking, Converter={StaticResource Vis}}" />
                    </Grid>
                    <ComboBox Grid.Column="1" Style="{StaticResource ThemedCombo}" MinWidth="96" MaxWidth="150" Margin="6,0,0,0"
                              ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              IsEnabled="{Binding IsIdle}"
                              ToolTip="Model"
                              AutomationProperties.Name="Model"
                              Visibility="{Binding HasModelChoice, Converter={StaticResource Vis}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Notice banner (sign-in progress, attachment problems). -->
        <Border Grid.Row="1" Padding="12,7,6,7" BorderThickness="0,0,0,1" Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftLine}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Notice, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="6,0,0,0"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                    <v:Icon Data="{StaticResource IconCross}" Width="11" Height="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Settings. -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="14,10,4,12" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Vis}}">
            <!-- Scrolls when the palette is short (its height limit is set in CopilotPane.xaml.cs), so the composer stays visible. -->
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="APPROVALS" Style="{StaticResource SectionTitle}" />
                <RadioButton Style="{StaticResource ThemedRadio}" GroupName="ApprovalMode" IsChecked="{Binding IsAskDestructive, Mode=TwoWay}" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock Text="Ask before risky commands (recommended)" TextWrapping="Wrap" />
                        <TextBlock Text="Saving, exporting, plotting, PURGE, deleting layers, AUDIT and ERASE ALL wait for your Approve." Style="{StaticResource Caption}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ThemedRadio}" GroupName="ApprovalMode" IsChecked="{Binding IsAutoApprove, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="Never ask (auto-approve)" TextWrapping="Wrap" />
                        <TextBlock Text="Those commands run at once. Scripts, plug-ins, LISP and system commands stay blocked either way." Style="{StaticResource Caption}" />
                    </StackPanel>
                </RadioButton>

                <!-- AI BEHAVIOUR: the backend's shared switches (CopilotFeatures, settings.json), applied from the next message. -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasFeatures, Converter={StaticResource Vis}}">
                    <TextBlock Text="AI BEHAVIOUR" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding AskBeforeDrawing, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Ask before drawing">
                        <StackPanel>
                            <TextBlock Text="Ask before drawing" TextWrapping="Wrap" />
                            <TextBlock Text="Shows the room schedule and asks &quot;Shall I draw this?&quot; once before a new plan is drawn." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding AutoSwitchProvider, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Switch AI when one stops">
                        <StackPanel>
                            <TextBlock Text="Switch AI when one stops" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProviderOrderText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding AutoReview, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Second opinion after each drawing">
                        <StackPanel>
                            <TextBlock Text="Second opinion after each drawing" TextWrapping="Wrap" />
                            <TextBlock Text="Another AI checks the finished drawing (read-only) and lists what to fix. &quot;Review this plan&quot; does it any time." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding TutorMode, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Tutor mode">
                        <StackPanel>
                            <TextBlock Text="Tutor mode" TextWrapping="Wrap" />
                            <TextBlock Text="The AI explains each AutoCAD command it uses in one short line, so you learn as it draws." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding WebResearch, Mode=TwoWay}"
                              AutomationProperties.Name="Web research">
                        <StackPanel>
                            <TextBlock Text="Web research (let the AI search the internet for ideas)" TextWrapping="Wrap" />
                            <TextBlock Text="Only web search and reading pages, never anything else. Same as the globe &quot;Web&quot; button under the message box; applies to your next message." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- DRAWING AREA: focus mode and following the AI's drawing (FocusLayoutViewModel, panel.json; shared by the tabs). -->
                <StackPanel Margin="0,14,0,0" DataContext="{Binding Layout}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="DRAWING AREA" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding FocusModeOnOpen, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Use focus mode when the AI Copilot opens">
                        <StackPanel>
                            <TextBlock Text="Use focus mode when the AI Copilot opens" TextWrapping="Wrap" />
                            <TextBlock Text="Minimises the ribbon to its tab names and hides the ViewCube and navigation bar while this panel is open. The command line stays. Everything comes back when you close the panel or AutoCAD, or click the Focus button." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding FollowAiDrawing, Mode=TwoWay}"
                              AutomationProperties.Name="Follow the AI's drawing">
                        <StackPanel>
                            <TextBlock Text="Follow the AI's drawing" TextWrapping="Wrap" />
                            <TextBlock Text="After each drawing step, zooms to what the AI just drew when it is off screen or too small to see. Never while you are in a command of your own." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- QUICK ASK: the floating AI button in the drawing area and its shortcut (QuickAskOptions, quickask.json; shared by the tabs). -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="QUICK ASK" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding QuickAskSettings.ShowButton, Mode=TwoWay}" Margin="0,0,0,7"
                              AutomationProperties.Name="Show the floating AI button">
                        <StackPanel>
                            <TextBlock Text="Show the floating AI button" TextWrapping="Wrap" />
                            <TextBlock Text="A round AI button in the drawing area's top-right corner: click it, press the shortcut or type AI, say what you want and press Enter. The request goes to the chat of that drawing; this panel can stay closed." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="26,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shortcut" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="170" HorizontalAlignment="Left"
                                 Text="{Binding QuickAskSettings.ShortcutText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Quick Ask shortcut" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Default" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ResetQuickAskShortcutCommand}" ToolTip="Ctrl+Shift+Space" />
                    </Grid>
                    <TextBlock Margin="26,3,0,0" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                               Text="{Binding QuickAskSettings.ShortcutError}"
                               Visibility="{Binding QuickAskSettings.HasShortcutError, Converter={StaticResource Vis}}" />
                    <TextBlock Margin="26,3,0,0" Style="{StaticResource Caption}"
                               Text="Ctrl or Alt plus Space, a letter, a digit or F1-F12. AIBUTTON shows / hides the button; -AI asks on the command line." />
                </StackPanel>

                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasVoice, Converter={StaticResource Vis}}">
                    <TextBlock Text="VOICE INPUT" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ThemedCheck}" IsChecked="{Binding VoiceAutoSend, Mode=TwoWay}" Margin="0,0,0,8"
                              AutomationProperties.Name="Send automatically after speaking">
                        <StackPanel>
                            <TextBlock Text="Send automatically after speaking" TextWrapping="Wrap" />
                            <TextBlock Text="Off: the words wait in the message box so you can check them and press Enter." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Language" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource ThemedCombo}" MaxWidth="240" MinWidth="190" HorizontalAlignment="Left"
                                  ItemsSource="{Binding VoiceLanguageChoices}" SelectedItem="{Binding SelectedVoiceLanguage, Mode=TwoWay}"
                                  AutomationProperties.Name="Voice language" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Mic button or Ctrl+Space. Uses the speech recognition built into Windows: no account or key. Best with Windows Settings &gt; Privacy &gt; Speech &gt; Online speech recognition on; otherwise the offline recognizer is used when installed." />
                </StackPanel>

                <TextBlock Text="LEARNING" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="The AI keeps your rules, recipes, lessons and drawing style on this PC and uses them in every chat. Say &quot;remember ...&quot; or &quot;forget ...&quot; in a message." />
                <WrapPanel Margin="0,7,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,8,4" Command="{Binding LearnStyleCommand}"
                            ToolTip="Sends &quot;Learn my style from this drawing&quot;: layers, text and dimension styles, wall thickness ..."
                            AutomationProperties.Name="Learn my style">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconSparkle}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" IsFilled="True" />
                            <TextBlock Text="Learn my style" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Margin="0,0,0,4" VerticalAlignment="Center" Command="{Binding OpenKnowledgeFolderCommand}"
                            ToolTip="{Binding KnowledgeDirectory}" AutomationProperties.Name="Open knowledge folder"
                            Visibility="{Binding HasKnowledgeDirectory, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" />
                            <TextBlock Text="Open knowledge folder" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="AI ACCOUNTS" Style="{StaticResource SectionTitle}" />
                    <Button Style="{StaticResource MutedGhostButton}" HorizontalAlignment="Right" Margin="0,-4,0,0" Padding="5,2"
                            Command="{Binding RefreshStatusCommand}" ToolTip="Check the sign-in state again">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                            <TextBlock Text="Check again" Margin="5,0,0,0" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                    <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding DetailText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Sign in" Padding="10,3" VerticalAlignment="Top"
                                        Command="{Binding DataContext.SignInCommand, ElementName=Root}" CommandParameter="{Binding}"
                                        Visibility="{Binding CanSignIn, Converter={StaticResource Vis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="No API keys: each provider runs its official command-line app, signed in with your own account. Your provider, model and drafting speed are remembered." />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Conversation and empty states. -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Items}" Margin="12,8,10,4" Focusable="False" KeyboardNavigation.TabNavigation="Continue" />
            </ScrollViewer>

            <!-- No CLI signed in. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding ShowSetup, Converter={StaticResource Vis}}">
                <StackPanel Margin="16,18,14,12">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <v:Icon Data="{StaticResource IconSignIn}" Width="20" Height="20" Foreground="{DynamicResource AccentText}" />
                    </Border>
                    <TextBlock Text="Connect an AI account" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12"
                               Text="AI Copilot works through the official apps of Claude, ChatGPT and Gemini on this PC, signed in with your own subscription. No API keys needed." />
                    <ItemsControl ItemsSource="{Binding Providers}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                                <Border Style="{StaticResource Card}" Padding="11,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusDot}" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Margin="7,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="15,2,0,0"><Run Text="{Binding CliName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AccountKind, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="15,2,0,0" Foreground="{DynamicResource TextMuted}" />
                                            <Border Background="{DynamicResource CodeBackground}" CornerRadius="4" Padding="6,3" Margin="15,5,0,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsNotInstalled, Converter={StaticResource Vis}}">
                                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding InstallCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Sign in" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Command="{Binding DataContext.SignInCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanSignIn, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Sign in once: a terminal window opens where you log in with your account. Come back here when it says you are signed in." />
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding RefreshStatusCommand}">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                            <TextBlock Text="Check again" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Welcome with example prompts. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding ShowWelcome, Converter={StaticResource Vis}}">
                <StackPanel Margin="16,18,14,12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <v:Icon Data="{StaticResource IconDraft}" Width="20" Height="20" Foreground="{DynamicResource AccentText}" />
                    </Border>
                    <TextBlock Text="{Binding WelcomeTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Text="{Binding WelcomeSubtitle, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="TRY" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding ExamplePrompts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PromptCard}"
                                        Command="{Binding DataContext.UseExampleCommand, ElementName=Root}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <v:Icon Data="{StaticResource IconSparkle}" IsFilled="True" Width="11" Height="11" Foreground="{DynamicResource AccentText}"
                                                VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Live status while a turn runs and no answer text streams: "Thinking... 0:42", "Typing AutoCAD commands: ...". -->
        <StackPanel Grid.Row="4">
            <Border x:Name="ActivityLine" Margin="12,2,12,4" Padding="2,3" Focusable="False"
                    Visibility="{Binding ShowActivity, Converter={StaticResource Vis}}"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ActivityText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <v:Spinner Width="13" Height="13" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}" />
                    <TextBlock Grid.Column="1" Text="{Binding ActivityText}" Margin="8,0,6,0" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityText}" />
                    <TextBlock Grid.Column="2" Text="{Binding ActivityElapsed}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource MonoFont}" />
                </Grid>
            </Border>

            <!-- Task Progress pinned while a turn runs (its task list scrolls after about 6 rows). -->
            <ContentControl Content="{Binding Plan}" Margin="10,4,10,6" Focusable="False"
                            Visibility="{Binding IsPlanPinned, Converter={StaticResource Vis}}">
                <ContentControl.Resources>
                    <Style x:Key="PlanTaskScroller" TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="MaxHeight" Value="124" />
                    </Style>
                </ContentControl.Resources>
            </ContentControl>

            <!-- TASK QUEUE: requests that run one after another in this chat. Drag the grip (or use the arrows) to reorder. -->
            <Border x:Name="QueuePanel" Style="{StaticResource Card}" Margin="10,2,10,6" Padding="0"
                    Visibility="{Binding HasQueue, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding QueueHeader}">
                <StackPanel>
                    <Grid Margin="4,3,4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource RowButton}" Padding="6,3" Command="{Binding ToggleQueueCommand}" ToolTip="Show or hide the queue">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <v:Icon Data="{StaticResource IconQueue}" Width="14" Height="14" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding QueueHeader}" FontWeight="SemiBold" Margin="7,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding QueueStatusText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding QueueStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQueuePaused}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" FontSize="11" Padding="7,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ResumeQueueCommand}" Visibility="{Binding IsQueuePaused, Converter={StaticResource Vis}}"
                                ToolTip="Continue: the next request starts when this chat is free" AutomationProperties.Name="Resume queue">
                            <StackPanel Orientation="Horizontal">
                                <v:Icon Data="{StaticResource IconPlay}" IsFilled="True" Width="9" Height="9" VerticalAlignment="Center" />
                                <TextBlock Text="Resume" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource MutedGhostButton}" FontSize="11" Padding="7,2" Margin="2,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ClearQueueCommand}" ToolTip="Remove every waiting request" AutomationProperties.Name="Clear queue">
                            <TextBlock Text="Clear" />
                        </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Margin="0,0,0,4" Visibility="{Binding IsQueueExpanded, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Queue}" Focusable="False" Margin="4,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueuedRequest}">
                                    <Border x:Name="QueueRow" Background="Transparent" CornerRadius="4" Padding="0,1" AllowDrop="True"
                                            DragOver="OnQueueRowDragOver" Drop="OnQueueRowDrop" ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="16" Height="22" Background="Transparent" Cursor="SizeNS" ToolTip="Drag to change the order"
                                                    PreviewMouseLeftButtonDown="OnQueueGripMouseDown" PreviewMouseMove="OnQueueGripMouseMove">
                                                <v:Icon Data="{StaticResource IconGrip}" Width="11" Height="11" Foreground="{DynamicResource TextMuted}" />
                                            </Border>
                                            <Border Grid.Column="1" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Margin="2,0,7,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceAltBackground}">
                                                <TextBlock Text="{Binding Position}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="3" x:Name="UpButton" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.MoveQueuedUpCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Move up" AutomationProperties.Name="Move up" Visibility="Hidden">
                                                <v:Icon Data="{StaticResource IconArrowUp}" Width="11" Height="11" />
                                            </Button>
                                            <Button Grid.Column="4" x:Name="DownButton" Style="{StaticResource IconButton}" Width="20" Height="20"
                                                    Command="{Binding DataContext.MoveQueuedDownCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Move down" AutomationProperties.Name="Move down" Visibility="Hidden">
                                                <v:Icon Data="{StaticResource IconArrowDown}" Width="11" Height="11" />
                                            </Button>
                                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="20" Height="20"
                                                    Command="{Binding DataContext.RemoveQueuedCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Remove from the queue" AutomationProperties.Name="Remove from queue">
                                                <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="QueueRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="QueueRow" Property="Background" Value="{DynamicResource HoverBackground}" />
                                            <Setter TargetName="UpButton" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="DownButton" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="QueueRow" Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="UpButton" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="DownButton" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- QUICK PROMPTS (⚡): built-in and saved prompts; an inline editor saves the current message or edits one. -->
            <Border x:Name="QuickMenu" Style="{StaticResource Card}" Margin="10,2,10,6" Padding="0,0,0,6"
                    Visibility="{Binding IsQuickMenuOpen, Converter={StaticResource Vis}}" AutomationProperties.Name="Quick prompts">
                <StackPanel DataContext="{Binding QuickPrompts}">
                    <Grid Margin="10,6,4,2">
                        <TextBlock Text="QUICK PROMPTS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="20" Height="20" HorizontalAlignment="Right"
                                Command="{Binding DataContext.ToggleQuickMenuCommand, ElementName=Root}" ToolTip="Close (Esc)" AutomationProperties.Name="Close quick prompts">
                            <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" />
                        </Button>
                    </Grid>

                    <!-- The list. -->
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding IsMenuListVisible, Converter={StaticResource Vis}}">
                        <StackPanel Margin="4,0,6,0">
                            <ItemsControl ItemsSource="{Binding BuiltIns}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuickPromptItem}">
                                        <Button Style="{StaticResource RowButton}" Padding="6,4" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.UseQuickPromptCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <v:Icon Data="{StaticResource IconBolt}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="YOURS" Style="{StaticResource SectionTitle}" Margin="6,8,0,2" Visibility="{Binding HasSaved, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Saved}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuickPromptItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource RowButton}" Padding="6,4" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding DataContext.UseQuickPromptCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <v:Icon Data="{StaticResource IconSparkle}" IsFilled="True" Width="10" Height="10" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                    Command="{Binding DataContext.QuickPrompts.EditCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Edit" AutomationProperties.Name="Edit quick prompt">
                                                <v:Icon Data="{StaticResource IconEdit}" Width="11" Height="11" />
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                    Command="{Binding DataContext.QuickPrompts.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Delete" AutomationProperties.Name="Delete quick prompt">
                                                <v:Icon Data="{StaticResource IconTrash}" Width="11" Height="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,6,0,4" />
                            <Button Style="{StaticResource LinkButton}" Margin="3,0,0,0" Padding="4,2"
                                    Command="{Binding DataContext.SaveQuickPromptCommand, ElementName=Root}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Type a message first, then save it here to reuse it with one click" AutomationProperties.Name="Save current message as a quick prompt">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IconPlus}" Width="11" Height="11" Foreground="{DynamicResource AccentText}" />
                                    <TextBlock Text="Save current message as a quick prompt" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The editor. -->
                    <StackPanel Margin="10,2,10,0" Visibility="{Binding IsEditorOpen, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding EditorHeader}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Name in the menu" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                 AutomationProperties.Name="Quick prompt name" />
                        <TextBlock Text="Message" Style="{StaticResource Caption}" Margin="0,7,0,3" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Quick prompt message" />
                        <TextBlock Text="{Binding EditError}" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}" Margin="0,5,0,0"
                                   Visibility="{Binding HasEditError, Converter={StaticResource Vis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save" FontSize="11" Padding="12,3" Command="{Binding CommitEditCommand}"
                                    AutomationProperties.Name="Save quick prompt" />
                            <Button Style="{StaticResource MutedGhostButton}" Content="Cancel" FontSize="11" Padding="8,3" Margin="6,0,0,0" Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CLICK TO POINT: AutoCAD waits for a click in the drawing (the user's 📍 Point, or the AI's pick_point). -->
            <Border x:Name="PickBanner" Margin="10,2,10,6" Padding="10,7,6,7" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}"
                    Visibility="{Binding ShowPickBanner, Converter={StaticResource Vis}}"
                    AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding PickBannerText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                        <v:PulseRing Foreground="{DynamicResource Accent}" Growth="1.8" />
                        <v:Icon Data="{StaticResource IconPin}" Width="15" Height="15" Foreground="{DynamicResource AccentText}" StrokeThickness="1.6" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="9,0,6,0">
                        <TextBlock Text="{Binding PickBannerText}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding PickBannerHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Cancel" FontSize="11" Padding="9,2" VerticalAlignment="Top"
                            Command="{Binding CancelPickCommand}" ToolTip="Stop waiting for a click (Esc)" AutomationProperties.Name="Cancel pick" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Composer. -->
        <Border x:Name="ComposerFrame" Grid.Row="5" Margin="10,2,10,10" CornerRadius="8" BorderThickness="1" AllowDrop="True"
                Background="{DynamicResource InputBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Recording}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Voice input problem: what happened, what to do, and the Windows Settings page. -->
                <Border Margin="8,8,8,0" Padding="9,7,3,8" CornerRadius="6" BorderThickness="1"
                        Visibility="{Binding Voice.HasProblem, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftLine}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Voice.ProblemIsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:Icon Data="{StaticResource IconMicOff}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1" Margin="8,0,4,0">
                            <TextBlock Text="{Binding Voice.Problem.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding Voice.Problem.Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <Button Style="{StaticResource LinkButton}" Margin="-3,4,0,0" Command="{Binding Voice.OpenProblemSettingsCommand}"
                                    ToolTip="Opens the Windows Settings page" AutomationProperties.Name="Open Windows Settings"
                                    Visibility="{Binding Voice.HasProblemSettings, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open Windows Settings" FontWeight="SemiBold" />
                                    <v:Icon Data="{StaticResource IconChevronRight}" Width="10" Height="10" Margin="3,1,0,0" StrokeThickness="1.8"
                                            Foreground="{DynamicResource AccentText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20" VerticalAlignment="Top"
                                Command="{Binding Voice.DismissProblemCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                            <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Attachments}" Margin="8,8,8,0" Focusable="False"
                              Visibility="{Binding HasAttachments, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                            <Border Background="{DynamicResource SurfaceAltBackground}" CornerRadius="5" Padding="6,2,2,2" Margin="0,0,5,5" MaxWidth="220"
                                    ToolTip="{Binding Path}">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon x:Name="Glyph" Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="5,0,2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    <Button Style="{StaticResource IconButton}" Width="18" Height="18"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            ToolTip="Remove" AutomationProperties.Name="Remove attachment">
                                        <v:Icon Data="{StaticResource IconCross}" Width="9" Height="9" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IconImage}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Listening: pulsing red dot, status, language and recognizer. -->
                <Border Margin="8,8,8,0" Padding="9,5,8,5" CornerRadius="6" Background="{DynamicResource RecordingSoft}"
                        Visibility="{Binding Voice.ShowStrip, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Width="9" Height="9" VerticalAlignment="Center">
                            <v:PulseRing Foreground="{DynamicResource Recording}" Growth="2.4" />
                            <Ellipse Fill="{DynamicResource Recording}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Voice.StatusText}" Margin="8,0,10,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource RecordingText}" />
                        <TextBlock Grid.Column="2" Text="{Binding Voice.EngineText}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Voice.EngineText}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Voice.EngineNotice}" Style="{StaticResource Caption}" Margin="17,3,0,0"
                                   Visibility="{Binding Voice.HasEngineNotice, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                    </Grid>
                </Border>
                <!-- SELECT AND ASK: objects selected in AutoCAD go with the next message (handles + a short description). -->
                <Border x:Name="SelectionChip" Margin="8,8,8,0" Padding="7,2,2,2" CornerRadius="11" HorizontalAlignment="Left"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}" BorderThickness="1"
                        Visibility="{Binding HasSelectionChip, Converter={StaticResource Vis}}" ToolTip="{Binding SelectionChipToolTip}"
                        AutomationProperties.Name="{Binding SelectionChipText}">
                    <StackPanel Orientation="Horizontal">
                        <v:Icon Data="{StaticResource IconCursor}" Width="12" Height="12" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectionChipText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                   Margin="5,0,2,0" VerticalAlignment="Center" />
                        <TextBlock Text="· goes with your message" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="2,0,2,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="18" Height="18" Margin="2,0,0,0" Command="{Binding DismissSelectionCommand}"
                                ToolTip="Leave the selection out of this message" AutomationProperties.Name="Leave the selection out">
                            <v:Icon Data="{StaticResource IconCross}" Width="8" Height="8" />
                        </Button>
                    </StackPanel>
                </Border>
                <TextBox x:Name="Composer" Style="{StaticResource ComposerBox}"
                         Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding Voice.IsActive, Mode=OneWay, FallbackValue=False}"
                         Tag="{Binding ComposerPlaceholder}"
                         AutomationProperties.Name="Message"
                         AutomationProperties.HelpText="Enter sends, Shift+Enter adds a new line" />
                <Grid Margin="5,0,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Command="{Binding AttachCommand}"
                            ToolTip="Attach images or PDF files (sketches, site plans)" AutomationProperties.Name="Attach files"
                            Visibility="{Binding CanAttach, Converter={StaticResource Vis}}">
                        <v:Icon Data="{StaticResource IconClip}" />
                    </Button>
                    <!-- Voice input: click (or Ctrl+Space) to speak the request; click again or pause to finish. -->
                    <Button x:Name="MicButton" Grid.Column="1" Style="{StaticResource MicButton}" Margin="1,0,0,0" Command="{Binding Voice.ToggleCommand}" Focusable="False"
                            ToolTip="{Binding Voice.MicToolTip}" AutomationProperties.Name="Voice input"
                            Visibility="{Binding HasVoice, Converter={StaticResource Vis}}">
                        <v:Icon Data="{StaticResource IconMic}" Width="15" Height="15" />
                    </Button>
                    <!-- Click to point: click points in the drawing; their coordinates go into the message. -->
                    <Button x:Name="PointButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="Auto" Padding="5,0,7,0" Margin="1,0,0,0"
                            Command="{Binding PickPointCommand}" Visibility="{Binding CanPickPoint, Converter={StaticResource Vis}}"
                            ToolTip="Point: click one or more points in the drawing (Enter when done, Esc cancels). Their coordinates go into your message, e.g. [point 12'-6&quot;,30'-0&quot; (150,360)]."
                            AutomationProperties.Name="Point">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconPin}" Width="14" Height="14" />
                            <TextBlock x:Name="PointLabel" Text="Point" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Web research: one click lets the AI search the internet for ideas (shared by all tabs, next message on). -->
                    <Button x:Name="WebButton" Grid.Column="3" Width="Auto" Padding="5,0,7,0" Margin="1,0,0,0"
                            Command="{Binding ToggleWebResearchCommand}" ToolTip="{Binding WebResearchToolTip}"
                            Visibility="{Binding HasFeatures, Converter={StaticResource Vis}}"
                            AutomationProperties.Name="Web research" AutomationProperties.HelpText="{Binding WebResearchToolTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WebResearch}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource IconGlobe}" Width="14" Height="14" StrokeThickness="1.4" />
                            <TextBlock x:Name="WebLabel" Text="Web" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Quick prompts. -->
                    <Button x:Name="QuickPromptButton" Grid.Column="4" Command="{Binding ToggleQuickMenuCommand}" Margin="1,0,0,0"
                            Visibility="{Binding HasQuickPrompts, Converter={StaticResource Vis}}"
                            ToolTip="Quick prompts (⚡): ready-made requests and your saved ones" AutomationProperties.Name="Quick prompts">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuickMenuOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <v:Icon Data="{StaticResource IconSparkle}" IsFilled="True" Width="13" Height="13" Foreground="{DynamicResource AccentText}" />
                    </Button>
                    <!-- Drafting speed: Watch (pauses so you can follow every input) or Fast. -->
                    <Border Grid.Column="5" Background="{DynamicResource SegmentTrack}" CornerRadius="6" Padding="2" Margin="4,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ComposerPace" IsChecked="{Binding IsWatchPace, Mode=TwoWay}"
                                         ToolTip="Watch: a short pause after every typed value, so you can follow each command in AutoCAD"
                                         AutomationProperties.Name="Watch mode">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IconEye}" Width="13" Height="13" StrokeThickness="1.4" />
                                    <TextBlock x:Name="WatchLabel" Text="Watch" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ComposerPace" IsChecked="{Binding IsFastPace, Mode=TwoWay}"
                                         ToolTip="Fast: commands are typed without pauses"
                                         AutomationProperties.Name="Fast mode">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IconBolt}" Width="13" Height="13" StrokeThickness="1.4" />
                                    <TextBlock x:Name="FastLabel" Text="Fast" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="6" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,8,0" TextTrimming="CharacterEllipsis"
                               ToolTip="Enter sends (while the AI works: adds to the queue) · Shift+Enter adds a new line · Ctrl+Space speaks · Esc stops">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Enter to send" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="Enter queues it" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Voice.IsActive}" Value="True">
                                        <Setter Property="Text" Value="Pause to finish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- While this chat works, the message can wait in its queue (Enter does the same). -->
                    <Button Grid.Column="7" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,4,0"
                            Command="{Binding AddToQueueCommand}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Add to queue (Enter): it runs by itself when this answer is done"
                            AutomationProperties.Name="Add to queue"
                            Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                        <v:Icon Data="{StaticResource IconQueueAdd}" Width="16" Height="16" />
                    </Button>
                    <Button Grid.Column="8" Width="30" Height="30" Command="{Binding SendCommand}"
                            ToolTip="Send (Enter)" AutomationProperties.Name="Send"
                            Visibility="{Binding IsIdle, Converter={StaticResource Vis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource SegmentTrack}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <v:Icon Data="{StaticResource IconSend}" Width="15" Height="15" StrokeThickness="1.9" />
                    </Button>
                    <Button Grid.Column="8" Width="30" Height="30" Command="{Binding StopCommand}"
                            ToolTip="Stop (Esc)" AutomationProperties.Name="Stop"
                            Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                                <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource PanelBackground}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <v:Icon Data="{StaticResource IconStop}" IsFilled="True" Width="13" Height="13" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
