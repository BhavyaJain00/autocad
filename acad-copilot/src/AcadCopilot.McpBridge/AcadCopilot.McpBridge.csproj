<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AcadCopilotMcp.exe: stdio MCP server launched by Claude Code / Codex / Gemini CLI (or Claude Desktop).
    It finds the running AutoCAD through %LOCALAPPDATA%\AcadCopilot\instances\<pid>.json, connects to the
    add-in over the authenticated named pipe and forwards MCP tools/list + tools/call.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AcadCopilot.McpBridge</RootNamespace>
    <AssemblyName>AcadCopilotMcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core package of the official MCP C# SDK (github.com/modelcontextprotocol/csharp-sdk); no hosting/DI needed. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcadCopilot.Core\AcadCopilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcadCopilot.McpBridge.Tests" />
  </ItemGroup>

</Project>
