<Project>
  <!--
    Shared settings for every project in AcadCopilot.sln.
    The AutoCAD add-in (AcadCopilot.Plugin) does not treat warnings as errors because the
    AutoCAD API surface produces obsolete/platform warnings we cannot always fix; every other
    project (pure libraries, the MCP bridge, tests) does.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>AcadCopilot</Company>
    <Product>AI Copilot for AutoCAD 2027</Product>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Where AutoCAD 2027 is installed. Override with -p:AcadInstallDir=... if it lives elsewhere. -->
    <AcadInstallDir Condition="'$(AcadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2027\</AcadInstallDir>
    <!-- Autodesk assemblies may reference newer framework assemblies than net10.0 ships: harmless, AutoCAD resolves them. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'AcadCopilot.Plugin'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- XML docs for non-test projects. Missing-doc warnings (CS1591) stay warnings, never errors. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
