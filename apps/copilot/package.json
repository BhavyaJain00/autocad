{
  "name": "@cadstudio/copilot",
  "productName": "CAD Copilot",
  "version": "0.1.0",
  "private": true,
  "description": "CAD Copilot: MecAgent-style AI assistant that docks beside AutoCAD or CAD Studio and drives it",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@cadstudio/cad-protocol": "*",
    "@cadstudio/copilot-agent": "*",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
